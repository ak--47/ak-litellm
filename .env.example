# ak-litellm configuration
# Copy to .env and fill in. NEVER commit .env.

# Bearer key for the LiteLLM gateway. Required.
LITELLM_API_KEY=

# Gateway base URL. Optional — defaults to https://litellm.mixpanel.org
LITELLM_BASE_URL=https://litellm.mixpanel.org

# Optional: set to 1 to run the live test suite (real gateway calls, real spend)
# LITELLM_LIVE=1

# Optional: set to 1 to silence the compatibility-layer warnings
# AK_LITELLM_SILENCE_COMPAT=1

# Optional: pino log level (trace|debug|info|warn|error|fatal|silent)
# LOG_LEVEL=info
